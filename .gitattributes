# Normalize line endings: store text files as LF in the repository.
* text=auto eol=lf

# Windows-only scripts keep CRLF in the working tree.
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.sln  text eol=crlf

# Binary files: never normalize or diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.pfx  binary
*.dll  binary
*.exe  binary
